{
  "manifestVersion": 1,
  "id": "openrouter-usage",
  "publisher": "tourbut",
  "name": "OpenRouter Usage",
  "version": "0.1.1",
  "description": "Open an OpenRouter usage dashboard from the command palette. Live data runs in an Orca browser tab.",
  "author": { "name": "tourbut" },
  "repository": "https://github.com/tourbut/orca-openrouter",
  "engines": { "orca": ">=1.4.198" },
  "pluginApi": 1,
  "main": "dist/main.mjs",
  "contributes": {
    "panels": [
      {
        "id": "usage",
        "title": "OpenRouter Usage",
        "icon": "activity",
        "entry": "dist/panel.html"
      }
    ],
    "commands": [
      { "id": "openrouter.openDashboard", "title": "OpenRouter: Open Dashboard" },
      { "id": "openrouter.status", "title": "OpenRouter: Connection Status" },
      { "id": "openrouter.refresh", "title": "OpenRouter: Refresh Usage" },
      { "id": "openrouter.disconnect", "title": "OpenRouter: Disconnect" }
    ]
  },
  "capabilities": [
    { "kind": "secrets" },
    { "kind": "storage" },
    { "kind": "settings:own" },
    { "kind": "notifications:show" }
  ]
}
